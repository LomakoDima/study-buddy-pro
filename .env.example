# Backend secrets (never expose these through VITE_* variables)
AI_API_KEY=your_ai_api_key
AI_MODEL=gpt-4.1-mini
# Optional for an OpenAI-compatible provider:
# AI_BASE_URL=https://api.openai.com/v1

TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_WEB_APP_URL=http://localhost:8080
# Leave this unset locally so the bot uses polling. Vercel detects its production webhook URL.
# TELEGRAM_WEBHOOK_URL=https://your-mini-app.example.com/api/telegram/webhook
# Generate both values independently, for example with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
WEBHOOK_SETUP_SECRET=replace_with_another_random_secret

DATABASE_PATH=./data/summarize.db
# Required on Vercel. Locally, omit this to keep using SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
MAX_FILE_MB=20
AI_CHUNK_CHARS=14000
FRONTEND_ORIGINS=http://localhost:8080

# Local browser authentication. Disable this in every public deployment.
DEV_MODE=true
DEV_USER_ID=10001
DEV_USER_NAME=Ava

# This value is safe to expose; it only points the frontend at the API.
VITE_API_URL=http://localhost:8000
# Vercel Functions accept request bodies up to 4.5 MB; use 4 in production.
VITE_MAX_FILE_MB=20
